# UrbanFootprint AI Environment Configuration
# Copy this file to .env and adjust as needed.

APP_NAME="UrbanFootprint AI"
APP_SUBTITLE="AI-Powered Building Footprint Extraction & Geospatial Mapping"
APP_VERSION="1.0.0"
DEBUG=true

# API & Server Settings
HOST="127.0.0.1"
PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Paths
UPLOAD_DIR="./data/uploads"
PROCESSED_DIR="./data/processed"
CHECKPOINT_DIR="./data/checkpoints"
DATASET_DIR="./data/datasets"
OUTPUT_DIR="./outputs"
DB_PATH="./backend/urbanfootprint.db"

# Inference Defaults
DEFAULT_CHECKPOINT_PATH="./data/checkpoints/urban_unet_best.pt"
DEFAULT_TILE_SIZE=512
DEFAULT_TILE_OVERLAP=64
DEFAULT_CONFIDENCE_THRESHOLD=0.50
DEFAULT_MIN_POLYGON_AREA=15.0
DEFAULT_SIMPLIFY_TOLERANCE=0.8

# Hardware Acceleration ('cpu' or 'cuda')
DEVICE_PREFERENCE="cpu"
