# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Data and artifacts (Do not commit user uploads, processed rasters, or big datasets)
data/uploads/*
!data/uploads/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/datasets/*
!data/datasets/.gitkeep
data/checkpoints/*
!data/checkpoints/.gitkeep
outputs/*
!outputs/.gitkeep
*.pt

# SQLite database
backend/urbanfootprint.db
*.sqlite
*.db

# Node / Next.js
node_modules/
**/node_modules/
.next/
**/.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
